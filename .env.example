APP_NAME="School Tuition and Payment Monitoring System"
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost/school_tuition

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_tuition_db
DB_USER=root
DB_PASS=

# Generate: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=PUT_BASE64_32_BYTE_KEY_HERE

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.test
SMTP_FROM_NAME="School Tuition System"
SMTP_ENCRYPTION=
